<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fieldset name="basic">
		<field
			name="id"
			type="number"
			readonly="true"
			default="0"
		/>

		<field
			name="destination_id"
			type="sql"
			label="COM_HOTELBOOKING_FIELD_DESTINATION_LABEL"
			required="true"
			query="SELECT id AS value, name AS text FROM #__hotelbooking_destinations WHERE published=1 ORDER BY name ASC"
			key_field="value"
			value_field="text"
			>
			<option value="">JOPTION_SELECT_AN_OPTION</option>
		</field>

		<field
			name="name"
			type="text"
			label="COM_HOTELBOOKING_FIELD_NAME_LABEL"
			required="true"
			size="40"
		/>

		<field
			name="description"
			type="editor"
			label="COM_HOTELBOOKING_FIELD_DESCRIPTION_LABEL"
			filter="safehtml"
		/>

		<field
			name="gallery"
			type="subform"
			label="COM_HOTELBOOKING_FIELD_GALLERY_LABEL"
			multiple="true"
			layout="joomla.form.field.subform.repeatable-table"
			formsource="administrator/components/com_hotelbooking/forms/subforms/gallery_item.xml"
			min="0"
			max="12"
		/>

		<field
			name="price"
			type="number"
			label="COM_HOTELBOOKING_FIELD_PRICE_LABEL"
			required="true"
			default="0"
			step="0.01"
			min="0"
		/>

		<field
			name="capacity"
			type="number"
			label="COM_HOTELBOOKING_FIELD_CAPACITY_LABEL"
			required="true"
			default="1"
			min="1"
		/>

		<field
			name="amenities"
			type="checkboxes"
			label="COM_HOTELBOOKING_FIELD_AMENITIES_LABEL"
			>
			<option value="wifi">COM_HOTELBOOKING_AMENITY_WIFI</option>
			<option value="tv">COM_HOTELBOOKING_AMENITY_TV</option>
			<option value="ac">COM_HOTELBOOKING_AMENITY_AC</option>
			<option value="breakfast">COM_HOTELBOOKING_AMENITY_BREAKFAST</option>
			<option value="parking">COM_HOTELBOOKING_AMENITY_PARKING</option>
			<option value="pool">COM_HOTELBOOKING_AMENITY_POOL</option>
			<option value="kitchen">COM_HOTELBOOKING_AMENITY_KITCHEN</option>
			<option value="balcony">COM_HOTELBOOKING_AMENITY_BALCONY</option>
			<option value="pet_friendly">COM_HOTELBOOKING_AMENITY_PET_FRIENDLY</option>
			<option value="non_smoking">COM_HOTELBOOKING_AMENITY_NON_SMOKING</option>
		</field>

		<field
			name="offers"
			type="subform"
			label="COM_HOTELBOOKING_FIELD_OFFERS_LABEL"
			multiple="true"
			layout="joomla.form.field.subform.repeatable-table"
			formsource="administrator/components/com_hotelbooking/forms/subforms/offer_item.xml"
			min="0"
			max="12"
		/>

		<field
			name="nearby_places"
			type="subform"
			label="COM_HOTELBOOKING_FIELD_NEARBY_LABEL"
			multiple="true"
			layout="joomla.form.field.subform.repeatable-table"
			formsource="administrator/components/com_hotelbooking/forms/subforms/nearby_place_item.xml"
			min="0"
			max="20"
		/>

		<field
			name="image"
			type="media"
			label="COM_HOTELBOOKING_FIELD_IMAGE_LABEL"
		/>

		<field
			name="published"
			type="list"
			label="COM_HOTELBOOKING_FIELD_PUBLISHED_LABEL"
			default="1"
			>
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
		</field>

		<field
			name="ordering"
			type="hidden"
			default="0"
		/>
	</fieldset>
</form>
