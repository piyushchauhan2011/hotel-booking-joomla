<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fields name="filter">
		<field
			name="search"
			type="text"
			label="COM_HOTELBOOKING_FILTER_SEARCH_LABEL"
			description="COM_HOTELBOOKING_FILTER_SEARCH_DESC"
			hint="JSEARCH_FILTER"
		/>

		<field
			name="published"
			type="list"
			label="JSTATUS"
			onchange="this.form.submit();"
			>
			<option value="">JOPTION_SELECT_PUBLISHED</option>
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
		</field>

		<field
			name="destination_id"
			type="sql"
			label="COM_HOTELBOOKING_FIELD_DESTINATION_LABEL"
			query="SELECT id AS value, name AS text FROM #__hotelbooking_destinations ORDER BY name ASC"
			key_field="value"
			value_field="text"
			onchange="this.form.submit();"
			>
			<option value="">JOPTION_SELECT_AN_OPTION</option>
		</field>
	</fields>

	<fields name="list">
		<field
			name="fullordering"
			type="list"
			default="a.ordering ASC"
			>
			<option value="a.name ASC">JGLOBAL_TITLE_ASC</option>
			<option value="a.name DESC">JGLOBAL_TITLE_DESC</option>
			<option value="a.published ASC">JSTATUS_ASC</option>
			<option value="a.published DESC">JSTATUS_DESC</option>
			<option value="a.ordering ASC">JGRID_HEADING_ORDERING_ASC</option>
			<option value="a.ordering DESC">JGRID_HEADING_ORDERING_DESC</option>
		</field>

		<field
			name="limit"
			type="limitbox"
			default="25"
		/>
	</fields>
</form>
