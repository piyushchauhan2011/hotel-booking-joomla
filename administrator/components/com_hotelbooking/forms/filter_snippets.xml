<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fields name="filter">
		<field
			name="search"
			type="text"
			label="COM_HOTELBOOKING_FILTER_SEARCH_LABEL"
			description="COM_HOTELBOOKING_SNIPPETS_SEARCH_DESC"
			hint="JSEARCH_FILTER"
		/>

		<field
			name="type"
			type="list"
			label="COM_HOTELBOOKING_SNIPPETS_FILTER_TYPE_LABEL"
			default="destination"
			>
			<option value="destination">COM_HOTELBOOKING_SNIPPETS_SECTION_DESTINATIONS</option>
			<option value="room">COM_HOTELBOOKING_SNIPPETS_SECTION_ROOMS</option>
			<option value="offer">COM_HOTELBOOKING_SNIPPETS_SECTION_OFFERS</option>
		</field>

		<field
			name="destination_id"
			type="sql"
			label="COM_HOTELBOOKING_FIELD_DESTINATION_LABEL"
			hiddenLabel="true"
			query="SELECT id AS value, name AS text FROM #__hotelbooking_destinations WHERE published = 1 ORDER BY name ASC"
			key_field="value"
			value_field="text"
			onchange="this.form.submit();"
			>
			<option value="">COM_HOTELBOOKING_SNIPPETS_FILTER_DESTINATION_ALL</option>
		</field>

		<field
			name="entity"
			type="list"
			label="COM_HOTELBOOKING_SNIPPETS_FILTER_ENTITY_LABEL"
			hiddenLabel="true"
			onchange="this.form.submit();"
			>
			<option value="">COM_HOTELBOOKING_SNIPPETS_FILTER_ENTITY_ALL</option>
			<option value="destination">COM_HOTELBOOKING_SNIPPETS_SECTION_DESTINATIONS</option>
			<option value="room">COM_HOTELBOOKING_SNIPPETS_SECTION_ROOMS</option>
		</field>
	</fields>

	<fields name="list">
		<field
			name="limit"
			type="limitbox"
			default="20"
			class="form-select"
			onchange="this.form.submit();"
			label="JGLOBAL_LIST_LIMIT"
			hiddenLabel="true"
		/>
	</fields>
</form>
