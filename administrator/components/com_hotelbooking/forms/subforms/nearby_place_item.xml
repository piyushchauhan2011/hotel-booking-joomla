<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fields name="nearby_place_item">
		<field
			name="name"
			type="text"
			label="COM_HOTELBOOKING_FIELD_NEARBY_NAME_LABEL"
			required="true"
			size="40"
		/>

		<field
			name="category"
			type="list"
			label="COM_HOTELBOOKING_FIELD_NEARBY_CATEGORY_LABEL"
			default="eating"
			>
			<option value="eating">COM_HOTELBOOKING_NEARBY_CATEGORY_EATING</option>
			<option value="shopping">COM_HOTELBOOKING_NEARBY_CATEGORY_SHOPPING</option>
			<option value="other">COM_HOTELBOOKING_NEARBY_CATEGORY_OTHER</option>
		</field>

		<field
			name="distance"
			type="text"
			label="COM_HOTELBOOKING_FIELD_NEARBY_DISTANCE_LABEL"
			hint="e.g. 0.3 mi, 5 min walk"
			size="20"
		/>
	</fields>
</form>
