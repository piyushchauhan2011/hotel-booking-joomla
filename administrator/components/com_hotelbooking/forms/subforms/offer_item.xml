<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fields name="offer_item">
		<field
			name="title"
			type="text"
			label="COM_HOTELBOOKING_FIELD_OFFER_TITLE_LABEL"
			required="true"
			size="40"
		/>

		<field
			name="description"
			type="textarea"
			label="COM_HOTELBOOKING_FIELD_OFFER_DESCRIPTION_LABEL"
			rows="3"
			cols="30"
		/>

		<field
			name="discount"
			type="text"
			label="COM_HOTELBOOKING_FIELD_OFFER_DISCOUNT_LABEL"
			hint="e.g. 20% off, $50 off"
			size="20"
		/>

		<field
			name="code"
			type="text"
			label="COM_HOTELBOOKING_FIELD_OFFER_CODE_LABEL"
			size="20"
		/>

		<field
			name="valid_from"
			type="calendar"
			label="COM_HOTELBOOKING_FIELD_OFFER_VALID_FROM_LABEL"
			format="%Y-%m-%d"
		/>

		<field
			name="valid_until"
			type="calendar"
			label="COM_HOTELBOOKING_FIELD_OFFER_VALID_UNTIL_LABEL"
			format="%Y-%m-%d"
		/>

		<field
			name="negotiation_status"
			type="list"
			label="COM_HOTELBOOKING_FIELD_OFFER_NEGOTIATION_STATUS_LABEL"
			default="proposed"
			>
			<option value="proposed">COM_HOTELBOOKING_OFFER_STATUS_PROPOSED</option>
			<option value="accepted">COM_HOTELBOOKING_OFFER_STATUS_ACCEPTED</option>
			<option value="rejected">COM_HOTELBOOKING_OFFER_STATUS_REJECTED</option>
		</field>
	</fields>
</form>
