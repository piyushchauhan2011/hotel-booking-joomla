<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fieldset name="basic">
		<field
			name="id"
			type="number"
			readonly="true"
			default="0"
		/>

		<field
			name="name"
			type="text"
			label="COM_HOTELBOOKING_FIELD_NAME_LABEL"
			required="true"
			size="40"
		/>

		<field
			name="alias"
			type="text"
			label="COM_HOTELBOOKING_FIELD_ALIAS_LABEL"
			hint="Auto-generated from name if left blank"
			size="40"
		/>

		<field
			name="description"
			type="editor"
			label="COM_HOTELBOOKING_FIELD_DESCRIPTION_LABEL"
			filter="safehtml"
		/>

		<field
			name="image"
			type="media"
			label="COM_HOTELBOOKING_FIELD_IMAGE_LABEL"
		/>

		<field
			name="gallery"
			type="subform"
			label="COM_HOTELBOOKING_FIELD_GALLERY_LABEL"
			multiple="true"
			layout="joomla.form.field.subform.repeatable-table"
			formsource="administrator/components/com_hotelbooking/forms/subforms/gallery_item.xml"
			min="0"
			max="12"
		/>

		<field
			name="amenities"
			type="checkboxes"
			label="COM_HOTELBOOKING_FIELD_HOTEL_AMENITIES_LABEL"
			>
			<option value="wifi">COM_HOTELBOOKING_AMENITY_WIFI</option>
			<option value="parking">COM_HOTELBOOKING_AMENITY_PARKING</option>
			<option value="pool">COM_HOTELBOOKING_AMENITY_POOL</option>
			<option value="restaurant">COM_HOTELBOOKING_AMENITY_RESTAURANT</option>
			<option value="bar">COM_HOTELBOOKING_AMENITY_BAR</option>
			<option value="front_desk_24h">COM_HOTELBOOKING_AMENITY_FRONT_DESK_24H</option>
			<option value="fitness_center">COM_HOTELBOOKING_AMENITY_FITNESS_CENTER</option>
			<option value="spa">COM_HOTELBOOKING_AMENITY_SPA</option>
			<option value="airport_shuttle">COM_HOTELBOOKING_AMENITY_AIRPORT_SHUTTLE</option>
			<option value="business_center">COM_HOTELBOOKING_AMENITY_BUSINESS_CENTER</option>
			<option value="laundry_service">COM_HOTELBOOKING_AMENITY_LAUNDRY_SERVICE</option>
			<option value="elevator">COM_HOTELBOOKING_AMENITY_ELEVATOR</option>
			<option value="conference_room">COM_HOTELBOOKING_AMENITY_CONFERENCE_ROOM</option>
			<option value="pet_friendly">COM_HOTELBOOKING_AMENITY_PET_FRIENDLY</option>
			<option value="non_smoking">COM_HOTELBOOKING_AMENITY_NON_SMOKING</option>
		</field>

		<field
			name="offers"
			type="subform"
			label="COM_HOTELBOOKING_FIELD_OFFERS_LABEL"
			multiple="true"
			layout="joomla.form.field.subform.repeatable-table"
			formsource="administrator/components/com_hotelbooking/forms/subforms/offer_item.xml"
			min="0"
			max="12"
		/>

		<field
			name="faqs"
			type="subform"
			label="COM_HOTELBOOKING_FIELD_FAQS_LABEL"
			multiple="true"
			layout="joomla.form.field.subform.repeatable-table"
			formsource="administrator/components/com_hotelbooking/forms/subforms/faq_item.xml"
			min="0"
			max="20"
		/>

		<field
			name="published"
			type="list"
			label="COM_HOTELBOOKING_FIELD_PUBLISHED_LABEL"
			default="1"
			>
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
		</field>

		<field
			name="ordering"
			type="hidden"
			default="0"
		/>
	</fieldset>
</form>
