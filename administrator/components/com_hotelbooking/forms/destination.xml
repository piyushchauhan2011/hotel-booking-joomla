<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fieldset name="basic">
		<field
			name="id"
			type="number"
			readonly="true"
			default="0"
		/>

		<field
			name="name"
			type="text"
			label="COM_HOTELBOOKING_FIELD_NAME_LABEL"
			required="true"
			size="40"
		/>

		<field
			name="alias"
			type="text"
			label="COM_HOTELBOOKING_FIELD_ALIAS_LABEL"
			hint="Auto-generated from name if left blank"
			size="40"
		/>

		<field
			name="description"
			type="editor"
			label="COM_HOTELBOOKING_FIELD_DESCRIPTION_LABEL"
			filter="safehtml"
		/>

		<field
			name="image"
			type="media"
			label="COM_HOTELBOOKING_FIELD_IMAGE_LABEL"
		/>

		<field
			name="gallery"
			type="subform"
			label="COM_HOTELBOOKING_FIELD_GALLERY_LABEL"
			multiple="true"
			layout="joomla.form.field.subform.repeatable-table"
			formsource="administrator/components/com_hotelbooking/forms/subforms/gallery_item.xml"
			min="0"
			max="12"
		/>

		<field
			name="offers"
			type="subform"
			label="COM_HOTELBOOKING_FIELD_OFFERS_LABEL"
			multiple="true"
			layout="joomla.form.field.subform.repeatable-table"
			formsource="administrator/components/com_hotelbooking/forms/subforms/offer_item.xml"
			min="0"
			max="12"
		/>

		<field
			name="published"
			type="list"
			label="COM_HOTELBOOKING_FIELD_PUBLISHED_LABEL"
			default="1"
			>
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
		</field>

		<field
			name="ordering"
			type="hidden"
			default="0"
		/>
	</fieldset>
</form>
