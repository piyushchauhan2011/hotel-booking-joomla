<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fields name="filter">
		<field
			name="search"
			type="text"
			label="COM_HOTELBOOKING_FILTER_SEARCH_LABEL"
			hint="JSEARCH_FILTER"
		/>

		<field
			name="status"
			type="list"
			label="COM_HOTELBOOKING_FIELD_STATUS_LABEL"
			onchange="this.form.submit();"
			>
			<option value="">JOPTION_SELECT_AN_OPTION</option>
			<option value="pending">COM_HOTELBOOKING_STATUS_PENDING</option>
			<option value="confirmed">COM_HOTELBOOKING_STATUS_CONFIRMED</option>
			<option value="cancelled">COM_HOTELBOOKING_STATUS_CANCELLED</option>
		</field>
	</fields>

	<fields name="list">
		<field
			name="fullordering"
			type="list"
			default="a.created DESC"
			>
			<option value="a.created ASC">JGLOBAL_DATE_ASC</option>
			<option value="a.created DESC">JGLOBAL_DATE_DESC</option>
			<option value="a.guest_name ASC">JGLOBAL_TITLE_ASC</option>
			<option value="a.guest_name DESC">JGLOBAL_TITLE_DESC</option>
		</field>

		<field
			name="limit"
			type="limitbox"
			default="25"
		/>
	</fields>
</form>
