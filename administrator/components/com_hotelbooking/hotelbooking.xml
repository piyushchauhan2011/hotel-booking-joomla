<?xml version="1.0" encoding="UTF-8"?>
<extension type="component" method="upgrade">
	<name>com_hotelbooking</name>
	<author>Piyush Chauhan</author>
	<creationDate>2026-08-29</creationDate>
	<copyright>(C) 2026 Piyush Chauhan. Learning project.</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<version>0.3.0</version>
	<description>COM_HOTELBOOKING_XML_DESCRIPTION</description>

	<namespace path="src">Learn\Component\Hotelbooking</namespace>
	<scriptfile>script.php</scriptfile>

	<install>
		<sql>
			<file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
		</sql>
	</install>
	<uninstall>
		<sql>
			<file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
		</sql>
	</uninstall>
	<update>
		<schemas>
			<schemapath type="mysql">sql/updates/mysql</schemapath>
		</schemas>
	</update>

	<files folder="site">
		<folder>src</folder>
		<folder>tmpl</folder>
		<folder>layouts</folder>
		<folder>services</folder>
	</files>

	<media folder="media" destination="com_hotelbooking">
		<folder>images</folder>
		<folder>css</folder>
		<folder>js</folder>
	</media>

	<administration>
		<menu img="class:hotelbooking">COM_HOTELBOOKING</menu>
		<submenu>
			<menu link="option=com_hotelbooking&amp;view=destinations">COM_HOTELBOOKING_SUBMENU_DESTINATIONS</menu>
			<menu link="option=com_hotelbooking&amp;view=rooms">COM_HOTELBOOKING_SUBMENU_ROOMS</menu>
			<menu link="option=com_hotelbooking&amp;view=bookings">COM_HOTELBOOKING_SUBMENU_BOOKINGS</menu>
			<menu link="option=com_hotelbooking&amp;view=faqs">COM_HOTELBOOKING_SUBMENU_FAQS</menu>
		</submenu>
		<files folder="admin">
			<folder>src</folder>
			<folder>tmpl</folder>
			<folder>forms</folder>
			<folder>services</folder>
			<folder>sql</folder>
			<filename>access.xml</filename>
			<filename>config.xml</filename>
			<filename>script.php</filename>
		</files>
		<languages folder="admin/language">
			<language tag="en-GB">en-GB/en-GB.com_hotelbooking.ini</language>
			<language tag="en-GB">en-GB/en-GB.com_hotelbooking.sys.ini</language>
			<language tag="th-TH">th-TH/th-TH.com_hotelbooking.ini</language>
			<language tag="th-TH">th-TH/th-TH.com_hotelbooking.sys.ini</language>
		</languages>
	</administration>

	<languages folder="site/language">
		<language tag="en-GB">en-GB/en-GB.com_hotelbooking.ini</language>
		<language tag="th-TH">th-TH/th-TH.com_hotelbooking.ini</language>
	</languages>
</extension>
