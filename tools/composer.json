{
	"name": "learn/hotelbooking-dev-tools",
	"description": "Isolated PHP lint, format, type-check, and test tooling for custom hotel-booking extensions.",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": "^8.3"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.64",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^11.5"
	},
	"autoload-dev": {
		"psr-4": {
			"Learn\\Component\\Hotelbooking\\Administrator\\": "../administrator/components/com_hotelbooking/src/",
			"Learn\\Component\\Hotelbooking\\Site\\": "../components/com_hotelbooking/src/",
			"Learn\\Module\\Hoteldetails\\Site\\": "../modules/mod_hoteldetails/src/",
			"Learn\\Module\\Hotelhero\\Site\\": "../modules/mod_hotelhero/src/",
			"Learn\\Module\\Hotelrooms\\Site\\": "../modules/mod_hotelrooms/src/",
			"Learn\\Plugin\\Content\\Hotelbooking\\": "../plugins/content/hotelbooking/src/",
			"Learn\\Plugin\\EditorsXtd\\Hotelbooking\\": "../plugins/editors-xtd/hotelbooking/src/",
			"Learn\\Plugin\\System\\Hbconsent\\": "../plugins/system/hbconsent/src/"
		}
	},
	"config": {
		"sort-packages": true
	},
	"scripts": {
		"cs-fix": "php-cs-fixer fix --config=.php-cs-fixer.php",
		"cs-check": "php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff",
		"phpstan": "phpstan analyse --memory-limit=1G",
		"phpstan-baseline": "phpstan analyse --memory-limit=1G --generate-baseline phpstan-baseline.neon",
		"test": "phpunit -c ../phpunit.xml.dist",
		"test:coverage": [
			"@php run-phpunit-coverage.php",
			"@php check-coverage.php ../build/coverage/clover.xml 80"
		]
	}
}
